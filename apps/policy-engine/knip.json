{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "tests/**/*.test.ts",
    "tools/**/*.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "tools/**/*.mjs"
  ],
  "includeEntryExports": true,
  "ignoreBinaries": [
    "mkfifo",
    "uv"
  ],
  "rules": {
    "cycles": "error",
    "duplicates": "error"
  }
}
