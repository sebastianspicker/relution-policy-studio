{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rexp-studio.example/schemas/mdm-policy-source.schema.json",
  "title": "MdmPolicySource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "platform", "model", "ownership", "enrollment_model", "layer", "purpose", "status", "evidence_status", "minimum_os", "controls", "dependencies", "environment_placeholders", "settings", "rings", "production_ready"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "pattern": "^[A-Z0-9-]+-L[0-7]-[A-Z]+-v[0-9]+$"},
    "platform": {"enum": ["IOS", "MACOS", "WINDOWS", "ANDROID_ENTERPRISE", "TVOS", "VISIONOS"]},
    "model": {"type": "string", "minLength": 1},
    "layer": {"type": "integer", "minimum": 0, "maximum": 7},
    "ownership": {"type": "string"},
    "enrollment_model": {"type": "string"},
    "purpose": {"type": "string"},
    "status": {"enum": ["active", "migration-only", "capability-only"]},
    "evidence_status": {"enum": ["APPROVED", "REFERENCE_VALIDATED", "NOT_EVIDENCED"]},
    "minimum_os": {"type": "string"},
    "controls": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "environment_placeholders": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "settings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["configuration_type", "values", "control_ids"], "properties": {"configuration_type": {"type": "string"}, "values": {"type": "object"}, "control_ids": {"type": "array", "items": {"type": "string"}}, "variants": {"type": "array"}}}},
    "rings": {"type": "array", "const": ["LAB"]},
    "production_ready": {"const": false},
    "legacy_source": {"type": "string"},
    "legacy_server_version": {"type": "string"}
  }
}
