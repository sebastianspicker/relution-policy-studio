{
  "name": "rexp-studio",
  "version": "0.1.0",
  "description": "CLI and loopback browser editor for Relution .rexp archives, Apple payloads, baseline data, and read-only device audits.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "rexp": "./dist/src/cli.js"
  },
  "exports": {
    "./host": "./dist/src/host/index.js",
    "./testing": "./dist/src/host/testing.js",
    "./browser": "./src/browser/index.ts",
    "./ui": "./web/src/studio-ui.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:node": "rm -rf dist && tsc -p tsconfig.json",
    "build:web": "rm -rf dist-web && vite build",
    "build:demo": "rm -rf dist-demo && vite build --mode demo",
    "check:bundle:web": "node tools/check-web-bundle-budget.mjs",
    "build": "pnpm build:node && pnpm build:web",
    "check:loc": "node tools/check-loc.mjs",
    "check:duplicates": "jscpd --config .jscpd.json --cross-formats js-ts .",
    "check:architecture": "node tools/check-architecture.mjs",
    "check:hygiene": "pnpm check:loc && pnpm check:duplicates && pnpm check:architecture",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "python:lint": "uv run --locked ruff check .",
    "python:test": "uv run --locked python -m unittest discover -s tests/python -v",
    "test:node:built": "cd dist && node --test",
    "test:node": "pnpm build:node && pnpm test:node:built",
    "test": "pnpm test:node",
    "verify:ci": "pnpm check:hygiene && pnpm build && pnpm check:bundle:web && pnpm test:node:built && pnpm python:lint && pnpm python:test",
    "verify:pre-pr": "pnpm verify:ci && pnpm codacy:cloud:inspect && pnpm codacy:cloud",
    "codacy:cloud-config": "node tools/run_codacy_cloud.mjs config",
    "codacy:cloud:inspect": "node tools/run_codacy_cloud.mjs inspect",
    "codacy:cloud": "node tools/run_codacy_cloud.mjs analyze",
    "rexp:evidence": "pnpm build && node tools/build_windows_rexp_evidence.mjs",
    "rexp:built": "node dist/src/cli.js",
    "rexp": "pnpm build && node dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jscpd": "5.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "5.51.2",
    "typescript": "7.0.2",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "js-yaml": "^5.4.2"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
