{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusweave.local/schemas/mapping.schema.json",
  "title": "CampusWeave Mapping",
  "type": "object",
  "required": [
    "intent_id",
    "workspace_id",
    "policy_id",
    "configuration_id",
    "field",
    "value",
    "platform",
    "configuration_type",
    "applicability",
    "reviewed",
    "profile_digest",
    "policy_revision"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "intent_id": { "type": "string", "pattern": "\\S", "maxLength": 256 },
    "workspace_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "policy_id": { "type": "string", "pattern": "\\S", "maxLength": 256 },
    "configuration_id": { "type": "string", "pattern": "\\S", "maxLength": 256 },
    "field": { "type": "string", "pattern": "\\S", "maxLength": 512 },
    "value": true,
    "platform": { "type": "string", "pattern": "\\S", "maxLength": 64 },
    "configuration_type": { "type": "string", "pattern": "\\S", "maxLength": 256 },
    "applicability": { "type": "string", "pattern": "\\S", "maxLength": 256 },
    "reviewed": { "type": "boolean" },
    "profile_digest": { "$ref": "#/$defs/digest" },
    "policy_revision": { "type": "string", "pattern": "\\S", "maxLength": 256 }
  },
  "additionalProperties": true,
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
