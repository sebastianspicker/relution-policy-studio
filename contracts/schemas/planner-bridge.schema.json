{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campusweave-planner-bridge-v1",
  "title": "CampusWeave bounded planner stdio protocol",
  "description": "One request is read through stdin EOF and one response is written to stdout. Requests are limited to 1048576 UTF-8 bytes. Requests and responses are each bounded to 1048576 UTF-8 bytes; response_too_large is a protocol error.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "message"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "profilePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "object"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "command",
        "payload"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "enum": [
            "validate",
            "compile",
            "reference",
            "convert-v1"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "const": "reference"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "maxProperties": 0
              }
            }
          },
          "else": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/profilePayload"
              }
            }
          }
        }
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "ok",
        "result"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "ok": {
          "const": true
        },
        "result": {}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "ok",
        "error"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "enum": [
                "request_too_large",
                "invalid_json",
                "invalid_request",
                "unsupported_version",
                "unknown_command",
                "response_too_large",
                "internal_error"
              ]
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/detail"
              }
            }
          }
        }
      }
    }
  }
}
