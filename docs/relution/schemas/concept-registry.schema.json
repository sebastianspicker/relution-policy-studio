{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusweave-relution.invalid/schemas/concept-registry.schema.json",
  "title": "CampusWeave Relution concept registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "document_id",
    "document_type",
    "product",
    "as_of",
    "scope",
    "completeness",
    "records"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^\\.\\./schemas/[a-z-]+\\.schema\\.json$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^relution\\.(features|settings|policies|groups)$"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "feature_registry",
        "setting_registry",
        "policy_registry",
        "group_registry"
      ]
    },
    "product": {
      "const": "Relution MDM"
    },
    "as_of": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_use",
        "not_authoritative_for"
      ],
      "properties": {
        "intended_use": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        },
        "not_authoritative_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/non_empty_string"
          }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "coverage_basis",
        "known_exclusions",
        "contract_boundary"
      ],
      "properties": {
        "level": {
          "const": "stable_capability_map"
        },
        "coverage_basis": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        },
        "known_exclusions": {
          "$ref": "common.schema.json#/$defs/string_array"
        },
        "contract_boundary": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/concept_record"
      }
    }
  }
}
