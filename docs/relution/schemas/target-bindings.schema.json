{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:campusweave-relution:schema:target-bindings:1.0.0",
  "title": "Relution target contract bindings",
  "description": "Digest-bound links from product concept and workflow pairs to exact operations in one generated Relution OpenAPI catalog. A concept may have multiple records only when each workflow_id is distinct.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "document_type",
    "binding_status",
    "sensitive_values_present",
    "target",
    "contract",
    "bindings",
    "unresolved_concept_ids"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "document_type": {
      "const": "relution-target-contract-bindings"
    },
    "binding_status": {
      "enum": ["template", "partial", "resolved", "stale"]
    },
    "sensitive_values_present": {
      "const": false
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_origin", "reported_version", "organization_id"],
      "properties": {
        "authorized_origin": {
          "type": ["string", "null"]
        },
        "reported_version": {
          "type": ["string", "null"]
        },
        "organization_id": {
          "type": ["string", "null"]
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_path",
        "source_sha256",
        "operation_count",
        "catalog_checked_current",
        "validated_at"
      ],
      "properties": {
        "catalog_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "catalog_checked_current": {
          "type": "boolean"
        },
        "validated_at": {
          "type": ["string", "null"]
        }
      }
    },
    "bindings": {
      "type": "array",
      "description": "Binding records are semantically unique by the pair (concept_id, workflow_id); the machine validator rejects duplicate pairs.",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "unresolved_concept_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/conceptId"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "binding_status": {
            "enum": ["partial", "resolved"]
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "authorized_origin": {
                "type": "string",
                "pattern": "^https://"
              },
              "reported_version": {
                "type": "string",
                "minLength": 1
              },
              "organization_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "contract": {
            "properties": {
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "operation_count": {
                "type": "integer",
                "minimum": 1
              },
              "catalog_checked_current": {
                "const": true
              },
              "validated_at": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "bindings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binding_status": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "properties": {
          "unresolved_concept_ids": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "conceptId": {
      "type": "string",
      "pattern": "^(feature|setting|policy|group)\\.[a-z0-9][a-z0-9._-]*$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "binding_completeness",
        "workflow_id",
        "required_roles",
        "operations",
        "scope_bindings",
        "notes"
      ],
      "properties": {
        "concept_id": {
          "$ref": "#/$defs/conceptId"
        },
        "binding_completeness": {
          "enum": ["partial", "complete_for_requested_workflow"]
        },
        "workflow_id": {
          "type": ["string", "null"]
        },
        "required_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/bindingRole" }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operationBinding"
          }
        },
        "scope_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scopeBinding"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "binding_completeness": { "const": "complete_for_requested_workflow" } },
            "required": ["binding_completeness"]
          },
          "then": {
            "properties": {
              "workflow_id": { "type": "string", "minLength": 1 },
              "required_roles": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "bindingRole": {
      "enum": [
        "read", "query", "create", "update", "replace", "patch", "delete",
        "publish", "assign", "unassign", "action", "validate", "status",
        "readback", "rollback", "audit"
      ]
    },
    "operationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "operation_key",
        "surface",
        "method",
        "path",
        "lineage",
        "operation_id",
        "request_schema_refs",
        "response_schema_refs",
        "expected_success_statuses",
        "source_contract_verified"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/bindingRole",
          "description": "The machine validator enforces role-specific HTTP methods for create, update, replace, patch, delete, publish, assign, unassign, action, and rollback; rejects mutation roles on non-mutating methods; and rejects one operation key mixing mutation roles or mutation and read-only roles within a workflow binding."
        },
        "operation_key": {
          "type": "string",
          "pattern": "^operation\\.sha256\\.[0-9a-f]{64}$"
        },
        "surface": {
          "const": "paths"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9!#$%&'*+.^_`|~-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "lineage": {
          "type": ["string", "null"]
        },
        "operation_id": {
          "type": ["string", "null"]
        },
        "request_schema_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "response_schema_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_success_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:2[0-9]{2}|2XX)$"
          }
        },
        "source_contract_verified": {
          "const": true
        }
      }
    },
    "scopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_kind",
        "location",
        "name",
        "operation_keys",
        "source_contract_verified"
      ],
      "properties": {
        "scope_kind": {
          "enum": ["system", "global_organization", "organization", "group", "user", "device"]
        },
        "location": {
          "enum": ["token", "server", "path", "query", "header", "request_body"]
        },
        "name": {
          "type": ["string", "null"]
        },
        "operation_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_contract_verified": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "location": {
                "enum": ["token", "server"]
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "location": {
                "enum": ["path", "query", "header", "request_body"]
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
