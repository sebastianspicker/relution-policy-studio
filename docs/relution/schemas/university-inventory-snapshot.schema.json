{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:campusweave-relution:schema:university-inventory-snapshot:1.0.0",
  "title": "CampusWeave bounded university inventory snapshot",
  "description": "A target-local, PII-free summary recording assertions from one bounded read-only inventory capture. Stable target IDs remain outside this summary; exact sets are represented by target-local digests. Runtime v1 validates structure and cross-artifact identity, not the truth of an unauthenticated assertion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "document_type", "snapshot_status",
    "sensitive_values_present", "profile_sha256", "target", "contract_sha256",
    "captured_at", "scope", "set_digests", "capture_proof"
  ],
  "properties": {
    "$schema": { "const": "urn:campusweave-relution:schema:university-inventory-snapshot:1.0.0" },
    "schema_version": { "const": "1.0.0" },
    "document_type": { "const": "relution-university-inventory-snapshot" },
    "snapshot_status": { "const": "complete" },
    "sensitive_values_present": { "const": false },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_origin", "relution_version", "organization_id"],
      "properties": {
        "authorized_origin": { "type": "string", "pattern": "^https://" },
        "relution_version": { "$ref": "#/$defs/nonEmptyString" },
        "organization_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "contract_sha256": { "$ref": "#/$defs/sha256" },
    "captured_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id", "platform_families", "device_count", "group_count",
        "policy_count", "assignment_count", "membership_frozen"
      ],
      "properties": {
        "organization_id": { "$ref": "#/$defs/nonEmptyString" },
        "platform_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ios_ipados", "macos", "windows", "android_enterprise"] }
        },
        "device_count": { "$ref": "#/$defs/count" },
        "group_count": { "$ref": "#/$defs/count" },
        "policy_count": { "$ref": "#/$defs/count" },
        "assignment_count": { "$ref": "#/$defs/count" },
        "membership_frozen": { "const": true }
      }
    },
    "set_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_ids_sha256", "group_ids_sha256", "policy_ids_sha256", "assignment_ids_sha256"],
      "properties": {
        "device_ids_sha256": { "$ref": "#/$defs/sha256" },
        "group_ids_sha256": { "$ref": "#/$defs/sha256" },
        "policy_ids_sha256": { "$ref": "#/$defs/sha256" },
        "assignment_ids_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "capture_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only", "pagination_complete", "reported_totals_reconciled", "duplicate_ids_rejected"],
      "properties": {
        "read_only": { "const": true },
        "pagination_complete": { "const": true },
        "reported_totals_reconciled": { "const": true },
        "duplicate_ids_rejected": { "const": true }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0 }
  }
}
