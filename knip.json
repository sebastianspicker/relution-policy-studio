{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/policy-engine": {
      "entry": [
        "tools/**/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "web/src/**/*.ts",
        "web/src/**/*.tsx",
        "tools/**/*.mjs"
      ]
    },
    "apps/workbench": {
      "project": [
        "src/**/*.ts",
        "src/**/*.tsx"
      ]
    }
  },
  "ignoreWorkspaces": [
    "apps/planner"
  ],
  "includeEntryExports": true,
  "ignoreBinaries": [
    "uv"
  ],
  "rules": {
    "cycles": "error",
    "duplicates": "error",
    "exports": "warn",
    "types": "warn"
  },
  "ignoreIssues": {
    "apps/policy-engine/src/host/testing.ts": [
      "exports"
    ],
    "apps/policy-engine/src/browser/campusweave.ts": [
      "types"
    ]
  }
}
